<h1 class="pb-4"><%= typeof pageHeading !== 'undefined' ? pageHeading : 'Explore Latest' %></h1>

<div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3">
  <% recipes.forEach(function(recipe) { %>
  <a href="/recipe/<%= recipe._id %>" class="col text-center category__link">
    <div class="category__img category__img--large shadow">
      <img
        src="<%= recipeImageSrc(recipe) %>"
        alt="<%= recipe.name %>"
        loading="lazy"
      />
    </div>
    <div class="pt-1"><%= recipe.name %></div>
    <div class="small text-muted">
      <i class="bi bi-clock"></i> <%= recipe.cookingTime ? recipe.cookingTime + ' min' : 'Time TBD' %>
      <i class="bi bi-star-fill text-warning ms-2"></i>
      <%= averageRating(recipe) ? averageRating(recipe).toFixed(1) : 'New' %>
    </div>
  </a>
  <% }) %>
</div>
