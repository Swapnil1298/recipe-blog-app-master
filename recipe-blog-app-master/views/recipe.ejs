<% if(recipe != null){ %>
<% const canManageRecipeImage = user && (recipe.user && recipe.user.toString() === user._id.toString() || user.isAdmin); %>
<% const hasRecipeImage = recipe.image || /masala\s+tea/i.test(recipe.name || ""); %>
<% const recipeAverageRating = averageRating(recipe); %>
<% const userRating = user && recipe.ratings ? recipe.ratings.find(function(rating) { return rating.user && rating.user.toString() === user._id.toString(); }) : null; %>
<% const isLiked = user && recipe.likes ? recipe.likes.some(function(likedUserId) { return likedUserId && likedUserId.toString() === user._id.toString(); }) : false; %>
<% const isSaved = user ? userHasRecipe(user.savedRecipes, recipe._id) : false; %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <li class="breadcrumb-item active" aria-current="page">
      <%- recipe.name %>
    </li>
  </ol>
</nav>

<% if (infoErrorsObj && infoErrorsObj.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
    <%= infoErrorsObj[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (infoSubmitObj && infoSubmitObj.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
    <%= infoSubmitObj[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="row">
  <div class="col-12 col-md-4">
    <% if (hasRecipeImage) { %>
      <img
        src="<%= recipeImageSrc(recipe) %>"
        alt="<%- recipe.name %>"
        class="img-fluid sticky-top"
        style="top: 20px"
        loading="lazy"
      />
    <% } else { %>
      <div class="recipe-image-placeholder sticky-top rounded-4 border border-2 border-dashed bg-light text-center p-4" style="top: 20px">
        <i class="bi bi-image fs-1 text-muted d-block mb-2"></i>
        <p class="fw-semibold text-muted mb-0">No recipe image uploaded yet.</p>
      </div>
    <% } %>

    <% if (canManageRecipeImage) { %>
      <div class="card recipe-image-upload-card border-0 shadow-sm rounded-4 mt-3">
        <div class="card-body">
          <h5 class="fw-bold mb-2">
            <i class="bi bi-image-fill me-1" style="color:#eb6928;"></i>
            <%= recipe.image ? "Update Recipe Image" : "Upload Recipe Image" %>
          </h5>
          <p class="text-muted small mb-3">
            <%= recipe.image ? "Choose a new image to replace the current recipe image." : "This recipe was submitted without an image. Choose an image here and upload it now." %>
          </p>

          <form action="/recipe/<%= recipe._id %>/image" method="post" enctype="multipart/form-data">
            <label for="recipeImageInput" class="form-label fw-semibold">Choose Image</label>
            <input
              type="file"
              id="recipeImageInput"
              name="image"
              accept="image/*"
              class="form-control mb-3"
              required
            />

            <img
              id="recipeImagePreview"
              src=""
              alt="Selected recipe image preview"
              class="img-fluid rounded-3 border mb-3 d-none"
              style="max-height: 220px; object-fit: cover; width: 100%;"
            />

            <button type="submit" class="btn rounded-pill px-4 fw-bold w-100" style="background:#eb6928; color:#fff; border:none;">
              <i class="bi bi-upload me-1"></i>Save Image to This Recipe
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <div class="col-12 col-md-8">
    <div class="row">
      <div class="col-12"><h1><%- recipe.name %></h1></div>
      <div class="col-12 mb-3 d-flex align-items-center gap-3 flex-wrap">
        <span><i class="bi bi-tag"></i> <%- recipe.category %></span>
        <% if (recipe.cookingTime) { %>
          <span><i class="bi bi-clock"></i> <%= recipe.cookingTime %> min</span>
        <% } %>
        <% if (recipe.servings) { %>
          <span><i class="bi bi-people"></i> <%= recipe.servings %> serving<%= recipe.servings !== 1 ? "s" : "" %></span>
        <% } %>
        <span><i class="bi bi-speedometer2"></i> <%= recipe.difficulty || "Easy" %></span>
        <span>
          <i class="bi bi-star-fill text-warning"></i>
          <%= recipeAverageRating ? recipeAverageRating.toFixed(1) : "No ratings yet" %>
          <% if (recipe.ratings && recipe.ratings.length > 0) { %>
            (<%= recipe.ratings.length %>)
          <% } %>
        </span>
        
        <!-- Likes Section -->
        <div class="d-flex align-items-center gap-2">
          <% if (user) { %>
            <form action="/recipe/<%= recipe._id %>/like" method="post" class="d-inline">
              <button type="submit" class="btn btn-link p-0 border-0 text-decoration-none d-flex align-items-center gap-1" style="box-shadow: none;">
                <% if (isLiked) { %>
                  <i class="bi bi-heart-fill fs-4 text-danger animate-pulse"></i>
                <% } else { %>
                  <i class="bi bi-heart fs-4 text-secondary hover-red"></i>
                <% } %>
                <span class="fw-bold text-dark fs-5"><%= (recipe.likes && recipe.likes.length) || 0 %></span>
              </button>
            </form>
          <% } else { %>
            <div class="d-flex align-items-center gap-1 text-muted" title="Log in to like this recipe!">
              <i class="bi bi-heart fs-4 text-secondary"></i>
              <span class="fw-bold fs-5"><%= (recipe.likes && recipe.likes.length) || 0 %></span>
              <small class="ms-2">(Log in to like)</small>
            </div>
          <% } %>
        </div>

        <% if (user) { %>
          <form action="/recipe/<%= recipe._id %>/save" method="post" class="d-inline">
            <button type="submit" class="btn btn-sm <%= isSaved ? 'btn-warning' : 'btn-outline-warning' %> rounded-pill fw-bold">
              <i class="bi <%= isSaved ? 'bi-bookmark-fill' : 'bi-bookmark' %> me-1"></i>
              <%= isSaved ? "Saved" : "Save" %>
            </button>
          </form>
        <% } %>

        <% if (user && (recipe.user && recipe.user.toString() === user._id.toString() || user.isAdmin)) { %>
          <form action="/recipe/<%= recipe._id %>/delete" method="post" class="d-inline ms-auto" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
            <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 py-1 px-3 rounded-pill fw-bold border-2 shadow-sm" style="font-size: 0.85rem; transition: all 0.3s ease;">
              <i class="bi bi-trash3-fill"></i> Delete Recipe
            </button>
          </form>
        <% } %>
      </div>
      <% if (user) { %>
        <div class="col-12 mb-4">
          <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
              <h5 class="fw-bold mb-3"><i class="bi bi-star-fill text-warning me-1"></i>Rate this recipe</h5>
              <form action="/recipe/<%= recipe._id %>/rate" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                <select name="rating" class="form-select" style="max-width: 220px;" required>
                  <option value="">Choose stars</option>
                  <% for (let star = 5; star >= 1; star--) { %>
                    <option value="<%= star %>" <%= userRating && userRating.value === star ? "selected" : "" %>>
                      <%= star %> Star<%= star !== 1 ? "s" : "" %>
                    </option>
                  <% } %>
                </select>
                <button type="submit" class="btn rounded-pill px-4 fw-bold" style="background:#eb6928; color:#fff; border:none;">
                  <%= userRating ? "Update Rating" : "Submit Rating" %>
                </button>
                <% if (userRating) { %>
                  <span class="text-muted small">Your current rating: <%= userRating.value %>/5</span>
                <% } %>
              </form>
            </div>
          </div>
        </div>
      <% } %>

      <div class="col-12" style="white-space: pre-line">
        <h4>Recipe Description</h4>
        <%- recipe.description %>
      </div>
    </div>
    <div class="row pt-4">
      <div class="col-12">
        <h4>Ingredients</h4>
        <ul class="list-group list-group-flush">
          <% recipe.ingredients.forEach(function(ingredient) { %>
          <li class="list-group-item"><%= ingredient %></li>
          <% }); %>
        </ul>
      </div>
    </div>
    <div class="row pt-4">
      <div class="col-12">
        <h4>Step-by-Step Instructions</h4>
        <% if (recipe.steps && recipe.steps.length > 0) { %>
          <ol class="list-group list-group-numbered">
            <% recipe.steps.forEach(function(step) { %>
              <li class="list-group-item"><%= step %></li>
            <% }); %>
          </ol>
        <% } else { %>
          <p class="text-muted">No separate steps were added for this recipe yet. Use the description above as the cooking guide.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Interactions & Comments Section -->
<hr class="my-5" />

<div class="row">
  <div class="col-lg-8 col-12 mx-auto">
    <h3 class="fw-bold mb-4"><i class="bi bi-chat-left-text me-2" style="color: #eb6928 !important;"></i>Comments (<%= (recipe.comments && recipe.comments.length) || 0 %>)</h3>

    <!-- Comment Input Form -->
    <% if (user) { %>
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 bg-light">
        <form action="/recipe/<%= recipe._id %>/comment" method="post">
          <div class="mb-3">
            <label for="commentTextarea" class="form-label fw-semibold text-muted">Join the conversation</label>
            <textarea name="comment" class="form-control rounded-3 border-0 shadow-sm" id="commentTextarea" rows="3" placeholder="Share your thoughts or tips on this recipe..." required></textarea>
          </div>
          <div class="text-end">
            <button type="submit" class="btn btn-primary px-4 fw-bold rounded-3 shadow-sm" style="background: #eb6928; border: none;">
              Post Comment
            </button>
          </div>
        </form>
      </div>
    <% } else { %>
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 text-center" style="border: 2px dashed #d0d0d0 !important;">
        <p class="mb-2 text-muted fw-semibold">Want to share your experience cooking this?</p>
        <a href="/login" class="btn btn-outline-primary px-4 fw-bold rounded-3" style="color: #eb6928; border-color: #eb6928; background: transparent;">
          Log in to Comment
        </a>
      </div>
    <% } %>

    <!-- Comments List -->
    <div class="comment-thread mt-4">
      <% if (recipe.comments && recipe.comments.length > 0) { %>
        <% recipe.comments.forEach(function(comment) { %>
          <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
            <div class="d-flex align-items-start gap-3">
              <!-- User Circular Avatar with Initials -->
              <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm" 
                   style="width: 48px; height: 48px; background: linear-gradient(135deg, #eb6928, #f7c0a5); font-size: 1.1rem; flex-shrink: 0;">
                <%= comment.userName ? comment.userName.charAt(0).toUpperCase() : 'U' %>
              </div>
              <!-- Comment Bubble -->
              <div class="flex-grow-1">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <h6 class="fw-bold mb-0 text-dark"><%= comment.userName %></h6>
                  <div class="d-flex align-items-center gap-3">
                    <small class="text-muted">
                      <%= new Date(comment.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </small>
                    <% if (user && user.isAdmin) { %>
                      <form action="/recipe/<%= recipe._id %>/comment/<%= comment._id %>/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this comment?');">
                        <button type="submit" class="btn btn-link p-0 text-danger" title="Delete Comment"><i class="bi bi-trash"></i></button>
                      </form>
                    <% } %>
                  </div>
                </div>
                <p class="mb-0 text-secondary" style="white-space: pre-line;"><%= comment.comment %></p>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="text-center py-4 text-muted">
          <i class="bi bi-chat-square-text fs-2 mb-2 d-inline-block"></i>
          <p class="mb-0">No comments yet. Be the first to share your thoughts!</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% } else { %>
<p>No item found.</p>
<% } %>

<script>
  const recipeImageInput = document.getElementById("recipeImageInput");
  const recipeImagePreview = document.getElementById("recipeImagePreview");

  if (recipeImageInput && recipeImagePreview) {
    recipeImageInput.addEventListener("change", function () {
      const file = this.files && this.files[0];

      if (!file) {
        recipeImagePreview.classList.add("d-none");
        recipeImagePreview.removeAttribute("src");
        return;
      }

      recipeImagePreview.src = URL.createObjectURL(file);
      recipeImagePreview.classList.remove("d-none");
    });
  }
</script>
